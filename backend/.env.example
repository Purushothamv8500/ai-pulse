# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=AI Pulse
APP_ENV=development
SECRET_KEY=your-super-secret-key-change-in-production-minimum-32-chars
DEBUG=true
FRONTEND_URL=http://localhost:3000

# Comma-separated list of allowed CORS origins (leave empty to derive from FRONTEND_URL)
CORS_ORIGINS=

# Set to false in the API Render service; the scheduler service sets this to true
ENABLE_SCHEDULER=true

# Number of uvicorn worker processes (production: 1-2; free tier: 1)
WEB_CONCURRENCY=1

# ── Database ──────────────────────────────────────────────────────────────────
# Local SQLite (development)
DATABASE_URL=sqlite+aiosqlite:///./aipulse.db
DATABASE_SYNC_URL=sqlite:///./aipulse.db

# Production PostgreSQL (uncomment and fill in for production)
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
# DATABASE_SYNC_URL=postgresql://user:password@host:5432/dbname

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── AI Providers ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here
AI_PROVIDER=anthropic
AI_MODEL_CHEAP=claude-haiku-4-5-20251001
AI_MODEL_QUALITY=claude-sonnet-4-6

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@aipulse.ai
SMTP_FROM_NAME=AI Pulse

# ── JWT ───────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Google OAuth (optional) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ── Supabase (optional — for social auth integration) ─────────────────────────
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Scheduler ─────────────────────────────────────────────────────────────────
INGESTION_INTERVAL_HOURS=6
BRIEFING_GENERATION_HOUR=7
BRIEFING_GENERATION_MINUTE=0

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
