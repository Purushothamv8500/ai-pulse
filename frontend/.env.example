# Backend API URL — used by Next.js at BUILD time to configure the /api/* proxy rewrite.
# For local development: set this to your local backend.
# For production (Vercel): set this in the Vercel dashboard Environment Variables.
#   If not set on Vercel, the proxy defaults to https://ai-pulse-pbbm.onrender.com.
NEXT_PUBLIC_API_URL=http://localhost:8000

NEXT_PUBLIC_APP_NAME=AI Pulse

# Supabase (required for Google OAuth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
